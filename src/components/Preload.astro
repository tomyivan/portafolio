---
import { Icon } from "astro-icon/components"
import { translations } from '../i18n/translations'

const t = translations.es;
const lineKeys = ["preload_1", "preload_2", "preload_3", "preload_4"];
---
<style>
    .preload {
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        position: fixed;
        background-color: #000;
        animation: opacity 1s forwards 2.9s;
        overflow: hidden;
    }

    @keyframes opacity {
        to {
            opacity: 0;
            visibility: hidden;
            z-index: -1;
        }
    }

    .preload-box {
        font-family: 'VT323', monospace;
        font-size: 1.75rem;
    }
</style>
<div class="preload flex flex-col justify-center items-center">
    <div class="battle-box preload-box text-white px-10 py-8 min-w-[280px]">
        <ul class="flex flex-col gap-2" id="list">
            {lineKeys.map((key) => (
                <li class="preload-line flex items-center gap-2 opacity-0">
                    <Icon name="heart" class="h-4 w-4 text-orange-400 shrink-0" />
                    <span data-i18n={key}>{t[key]}</span>
                </li>
            ))}
        </ul>
        <span class="advance-arrow float-right mt-2" id="preload-arrow">▼</span>
    </div>
</div>

<script>
import { gsap } from 'gsap';
import { applyTranslations } from '../i18n/client';

window.location.hash = '#Inicio';
applyTranslations();

const lines = gsap.utils.toArray('.preload-line');
const arrow = document.getElementById('preload-arrow');

gsap.set(arrow, { opacity: 0 });

const tl = gsap.timeline();
tl.to(lines, {
    opacity: 1,
    duration: 0.3,
    stagger: 0.5,
    ease: 'none',
}).to(arrow, { opacity: 1, duration: 0.2 });
</script>
