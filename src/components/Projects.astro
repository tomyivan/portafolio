---
import { translations } from '../i18n/translations'
const projects = [
  {
    title: "Sistema de Activos Fijos con generacion de QR - 2024",
    titleKey: "proj_fixed_title",
    label: "Activos Fijos",
    id: "fixed",
    description:
      "Sistema para la gestion de activos fijos, con generacion de codigos QR para facilitar su identificacion y seguimiento.",
    image: "/saf.png",
    tecnologies: ["NODEJS", "SQLSERVER", "HTML", "CSS", "REACT", "TAILWIND", "TYPESCRIPT", "EXPRESS" ],
    link: "#",
  },
  {
    title: "Sistema de archivo multimedia - 2023",
    titleKey: "proj_rh_title",
    label: "Archivo Multimedia",
    id: "rh",
    description:
      "Sistema para la gestion y archivo de contenido multimedia, permitiendo una organizacion eficiente y facil acceso a los recursos digitales.",
    image: "/box.png",
    tecnologies: ["NODEJS", "SQLSERVER", "HTML", "CSS", "REACT", "TAILWIND", "JAVASCRIPT", "EXPRESS" ],
  },
  {
    title: "Sistema de Control Biometrico - 2022",
    titleKey: "proj_biometric_title",
    label: "Control Biometrico",
    id: "biometric",
    description:
      "Sistema para el control de acceso mediante tecnologia biometrica.",
    image: "/comida.png",
    tecnologies: ["NODEJS", "SQLSERVER", "HTML", "CSS", "REACT", "BOOTSTRAP", "JAVASCRIPT", "EXPRESS" ],
    link: "#",
  },
  {
    title: "Sistema de Activos Fijos V1 con generacion de QR - 2023",
    titleKey: "proj_fixedV1_title",
    label: "Activos Fijos V1",
    id: "fixedV1",
    description:
      "Primera version del sistema para la gestion de activos fijos, con generacion de codigos QR para facilitar su identificacion y seguimiento.",
    image: "/activos-php-2.png",
    tecnologies: ["PHP", "MARIADB", "HTML", "CSS", "REACT", "BOOTSTRAP", "CODEIGNITER", "ADMINLTE" ],
    link: "#",
  },
  {
    title: "Generador de Paletas de Colores - 2026",
    titleKey: "proj_colorPalette_title",
    label: "Generador de Paletas",
    id: "colorPalette",
    description:
      "Sistema para la generacion de paletas de colores, permitiendo una seleccion eficiente y creativa de combinaciones de colores.",
    image: "/paletas.png",
    tecnologies: ["NEXT.JS", "HTML", "CSS", "REACT", "TAILWIND",  "ZUSTAND" ],
    link: "https://paletorgb2.vercel.app/",
  }
];
---
<style>
  .project-card:hover .tecnologies {
    display: block;
  }

  .project-title {
    font-family: 'VT323', monospace;
    font-size: 1.4rem;
    line-height: 1.3;
  }

  .tech-chip {
    font-family: 'Press Start 2P', system-ui;
    font-size: 0.55rem;
  }
</style>
<div class="w-full flex flex-col  py-8 " id="proyectos">
    <h2 class="text-4xl font-bold  text-orange-200" data-i18n="projects_title">{translations.es.projects_title}</h2>
    <ul class="flex flex-wrap justify-center md:justify-start w-full">
      {projects.map((project) => (
        <li class="project-card battle-box m-4 w-full max-w-md hover:scale-105 transition-transform duration-300 cursor-pointer relative">
          <img
            src={project.image}
            alt={project.title}
            class="w-full h-48 object-cover mb-4"
          />
          <h3 class="project-title font-bold mb-2 text-orange-200 px-4" data-i18n={project.titleKey}>{project.title}</h3>
          <div class="absolute top-0 bg-black p-2 h-full w-full hidden tecnologies">
            <div class="absolute flex-wrap flex gap-2 top-1/2 left-1/2 transform -translate-x-1/2 -translate-y-1/2 justify-center">
              {project.tecnologies.map((tech) => (
                <span class="tech-chip bg-black border border-orange-400 text-orange-300 px-2 py-1 ">
                  {tech}
                </span>
              ))}
            <a href={project.link} target="_blank" class="text-orange-400 hover:underline w-full text-center">{project.link}</a>
            </div>
          </div>
        </li>
      ))}
    </ul>
</div>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { applyTranslations, onLangChange } from '../i18n/client';
gsap.registerPlugin(ScrollTrigger);

applyTranslations();
onLangChange(() => applyTranslations());

const cards = gsap.utils.toArray('.project-card');
const scroller = document.getElementById('app-scroll');

if (cards.length) {
    gsap.set(cards, { opacity: 0, y: 40 });
    gsap.to(cards, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.15,
        ease: 'power2.out',
        scrollTrigger: {
            trigger: '#proyectos',
            scroller: scroller ?? window,
            start: 'top 85%',
        },
    });
}
</script>
