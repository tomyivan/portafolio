---
import { translations } from '../i18n/translations'
const t = translations.es;
---

<div class="w-full flex flex-col text-orange-400" id="AboutMe">
    <h2 class="text-4xl font-bold mb-12" data-i18n="about_title">{t.about_title}</h2>
    <div class="battle-box max-w-4xl p-6 space-y-6 about-box">
        <p class="about-line text-lg text-white" data-i18n="about_p1">{t.about_p1}</p>
        <p class="about-line text-lg text-white" data-i18n="about_p2">{t.about_p2}</p>
        <p class="about-line text-lg text-white" data-i18n="about_p3">{t.about_p3}</p>
        <span class="advance-arrow float-right">▼</span>
    </div>
</div>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { applyTranslations, onLangChange } from '../i18n/client';
gsap.registerPlugin(ScrollTrigger);

applyTranslations();
onLangChange(() => applyTranslations());

const box = document.querySelector('.about-box');
const lines = gsap.utils.toArray('.about-line');
const scroller = document.getElementById('app-scroll');

if (box && lines.length) {
    gsap.set(lines, { opacity: 0, y: 16 });
    gsap.to(lines, {
        opacity: 1,
        y: 0,
        duration: 0.6,
        stagger: 0.25,
        ease: 'power2.out',
        scrollTrigger: {
            trigger: box,
            scroller: scroller ?? window,
            start: 'top 80%',
        },
    });
}
</script>
