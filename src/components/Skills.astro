---
import { Icon } from 'astro-icon/components'
import { translations } from '../i18n/translations'
const title = translations.es.skills_title;
const skils = [
    { name: 'php', label: 'PHP', category: 'Backend' },
    { name: 'laravel', label: 'Laravel', category: 'Backend' },
    { name: 'node', label: 'Node.js', category: 'Backend' },
    { name: 'react', label: 'React', category: 'Frontend' },
    { name: 'python', label: 'Python', category: 'Backend' },
    { name: 'ts', label: 'TypeScript', category: 'Frontend' },
    { name: 'tailwind', label: 'Tailwind CSS', category: 'Frontend' },
    { name: 'mysql', label: 'MySQL', category: 'Database' },
    { name: 'sqlserver', label: 'SQL Server', category: 'Database' },
    { name: 'postgresql', label: 'PostgreSQL', category: 'Database' },
    { name: 'nextjs', label: 'Next.js', category: 'Frontend' },
    { name: 'firebase', label: 'Firebase', category: 'Baas' },
]
---
<style>

    .skill-card {
        position: relative;
        overflow: hidden;
        border: 3px solid #fff;
        background: #000;
        transition: transform 0.4s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s ease, box-shadow 0.3s ease;
    }

    .skill-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255, 140, 0, 0.3), transparent);
        transition: left 0.7s ease;
        z-index: 1;
    }

    .skill-card:hover::before {
        left: 100%;
    }

    .skill-card:hover {
        transform: translateY(-12px) scale(1.1);
        box-shadow: 0 0 30px rgba(255, 140, 0, 0.5),
                    inset 0 0 20px rgba(255, 140, 0, 0.1);
        border-color: #ff8c00;
    }

    .skill-card:active {
        transform: translateY(-6px) scale(0.98);
    }

    .skill-icon {
        color: #b87c2e;
        position: relative;
        z-index: 2;
        transition: all 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .skill-card:hover .skill-icon {
        color: #ffb347;
        transform: rotate(15deg) scale(1.2);
        filter: drop-shadow(0 0 12px rgba(255, 140, 0, 0.7));
    }

    .skill-content {
        position: relative;
        z-index: 2;
        text-align: center;
    }

    .skill-label {
        display: block;
        font-size: 1.125rem;
        font-weight: 600;
        transition: all 0.3s ease;
        color: #ffa726;
        font-family: 'Press Start 2P', system-ui;
        font-size: 0.7rem !important;
        line-height: 1.4;
    }

    .skill-category {
        display: block;
        font-size: 0.75rem;
        opacity: 0;
        transform: translateY(-5px);
        transition: all 0.3s ease;
        color: #ffb347;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-top: 0.5rem;
    }

    .skill-card:hover .skill-category {
        opacity: 1;
        transform: translateY(0);
    }

    .skill-card:hover .skill-label {
        text-shadow: 0 0 12px rgba(255, 140, 0, 0.6);
        letter-spacing: 0.5px;
    }

    @media (max-width: 1280px) {
    
        .skill-card {
            width: 160px;
            height: 200px;
        }
    }

    @media (max-width: 768px) {
        .skill-card {
            width: 140px;
            height: 180px;
        }
        .skill-icon {
            width: 3rem;
            height: 3rem;
        }
        .skill-label {
            font-size: 0.95rem;
        }
    }

    @media (max-width: 480px) {
        .skill-card {
            width: 120px;
            height: 160px;
        }
        .skill-icon {
            width: 2.5rem;
            height: 2.5rem;
        }
        .skill-label {
            font-size: 0.85rem;
        }
    }
</style>

<section class=" flex flex-wrap justify-center items-center gap-2  transition-all duration-300" id="habilidades">
    {
    <h2 class="w-full text-3xl font-bold  text-orange-300" data-i18n="skills_title">{title}</h2>
    }
    {skils.map((skill) => (
        <div class="skill-card flex flex-col items-center justify-center rounded-2xl p-6 w-44 h-52 cursor-pointer">
            <div class="skill-icon mb-2">
                <Icon name={skill.name} class="w-20 h-20" />
            </div>
            <div >
                <span class="skill-label">{skill.label}</span>
                <span class="skill-category">{skill.category}</span>
            </div>
        </div>
    ))}
</section>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { applyTranslations, onLangChange } from '../i18n/client';
gsap.registerPlugin(ScrollTrigger);

applyTranslations();
onLangChange(() => applyTranslations());

const cards = gsap.utils.toArray('.skill-card');
const scroller = document.getElementById('app-scroll');

if (cards.length) {
    gsap.set(cards, { opacity: 0, y: 30, scale: 0.85 });
    gsap.to(cards, {
        opacity: 1,
        y: 0,
        scale: 1,
        duration: 0.6,
        stagger: 0.08,
        ease: 'back.out(1.7)',
        scrollTrigger: {
            trigger: '#habilidades',
            scroller: scroller ?? window,
            start: 'top 85%',
        },
    });
}
</script>
