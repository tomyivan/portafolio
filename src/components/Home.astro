---
import { Icon } from 'astro-icon/components'
import { translations } from '../i18n/translations'
const hello = translations.es.home_hello;
const phrase = translations.es.home_phrase;
---
<style>
.button {
    background: #000;
    color: #ffedd5;
    padding: 0.5rem 1rem;
    border-radius: 12px;
    border: none;
    cursor: pointer;
    position: relative;
    font-family: 'Press Start 2P', system-ui;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 1px;
}

.button::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    background: linear-gradient(
        45deg,
        #ff7a00, #ffb703, #ff3d00, #ffb703, #ff7a00, #ffb703, #ff3d00, #ff7a00, #ffb703, #ff3d00, #ff7a00
    );
    background-size: 800%;
    border-radius: 10px;
    filter: blur(2px);
    animation: glow 20s linear infinite ;
}

@keyframes glow {
    0% {
        background-position: 0% 0;
    }
    50% {
        background-position: 400% 0%;
    }
    100% {
        background-position: 0 0;
    }
}

.cv-heart {
    opacity: 0;
    transform: scale(0.5);
    transition: opacity 0.25s ease, transform 0.25s ease;
}

.cv-link:hover .cv-heart {
    opacity: 1;
    transform: scale(1);
}

.hello-text {
    font-family: 'VT323', monospace;
    font-size: 6rem;
    color: #ff9d1fd9;
    text-shadow: 0 0 5px #ff7a0080, 0 0 10px #ff5e0066, 0 0 20px #ff9d1fba;
}

.type-cursor::after {
    content: '_';
    animation: advance-blink 0.9s steps(1) infinite;
}
</style>
<div class="w-full  flex flex-col justify-center text-3xl min-h-[80vh] gap-3 text-orange-400" id="home-section">
    <p class="font-semibold md:text-8xl  hello-text type-cursor" id="hello-text">{hello}</p>
    <p class="font-semibold md:text-2xl text-lg mt-4 text-white" id="phrase-text">{phrase}</p>
    <div class="text-sm p-2 opacity-0" id="cv-button">
        <a class="button cv-link inline-flex items-center gap-2" href="/CV_Tomy_Ivan_Bautista.pdf" target="_blank" rel="noopener noreferrer">
            <span data-i18n="home_cv">{translations.es.home_cv}</span>
            <Icon name="heart" class="cv-heart w-4 h-4 text-orange-400" />
        </a>
    </div>
</div>

<script>
import { gsap } from 'gsap';
import { TextPlugin } from 'gsap/TextPlugin';
import { getLang, onLangChange, applyTranslations } from '../i18n/client';
import { translations } from '../i18n/translations';
gsap.registerPlugin(TextPlugin);

const helloEl = document.getElementById('hello-text');
const phraseEl = document.getElementById('phrase-text');
const buttonEl = document.getElementById('cv-button');

if (helloEl && phraseEl && buttonEl) {
    const dict = translations[getLang()];
    helloEl.textContent = '';
    phraseEl.textContent = '';
    applyTranslations(buttonEl);

    const tl = gsap.timeline({ delay: 3 });
    tl.to(helloEl, { duration: 1.2, text: dict.home_hello, ease: 'none' })
      .to(phraseEl, { duration: 2.2, text: dict.home_phrase, ease: 'none' }, '+=0.2')
      .to(buttonEl, { duration: 0.5, opacity: 1, ease: 'back.out(2)' });

    onLangChange((lang) => {
        const newDict = translations[lang];
        gsap.to([helloEl, phraseEl], {
            opacity: 0,
            duration: 0.2,
            onComplete: () => {
                helloEl.textContent = newDict.home_hello;
                phraseEl.textContent = newDict.home_phrase;
                gsap.to([helloEl, phraseEl], { opacity: 1, duration: 0.3 });
            },
        });
    });
}
</script>
