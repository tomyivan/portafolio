---
import { Icon } from 'astro-icon/components'
import { translations } from '../i18n/translations'
const t = translations.es;
const experience = [
    {
        title: "Instituo Tecnológico Sebastián Obermaier (ITSO)",
        positionKey: "exp_itso_position",
        periodKey: "exp_itso_period",
        descKey: "exp_itso_desc",
    },
    {
        title: "Firma de abogados - Rigoberto Paredes y Asociados",
        positionKey: "exp_pasante_position",
        periodKey: "exp_pasante_period",
        descKey: "exp_pasante_desc",
        tecnologies: ["PHP", "HTML", "CSS", "JAVASCRIPT", "MYSQL"],
    },
    {
        title: "Universidad Mayor de San Andrés (UMSA)",
        positionKey: "exp_umsa_position",
        periodKey: "exp_umsa_period",
        descKey: "exp_umsa_desc",
    },
    {
        title: "Freelance",
        positionKey: "exp_fs_position",
        periodKey: "exp_fs_period",
        descKey: "exp_fs_desc",
        tecnologies: ["PHP", "NODEJS", "REACT", "TYPESCRIPT", "SQLSERVER", "TAILWIND"],
    },
]
---
<style>
    .exp-card {
        opacity: 0;
    }

    .tech-chip {
        font-family: 'Press Start 2P', system-ui;
        font-size: 0.55rem;
    }
</style>
<div class="w-full flex flex-col gap-6 text-white relative" id="experiencia">
    <h2 class="text-4xl font-bold text-orange-300" data-i18n="exp_title">{t.exp_title}</h2>
    {
        experience.map((exp) => (
            <div class="exp-card battle-box flex flex-col sm:flex-row justify-between items-start gap-4 p-4 transition-all duration-300">
                <div class="flex justify-center items-center sm:ps-10 shrink-0">
                    <Icon name="heart" class="text-orange-400 w-4 h-4 mr-2" />
                    <div class="text-2xl font-bold text-orange-400 whitespace-nowrap" data-i18n={exp.periodKey}>
                        {t[exp.periodKey]}
                    </div>
                </div>
                <div class="text-white sm:w-2/3">
                    <h3 class="text-xl font-bold">{exp.title}</h3>
                    <h4 class="text-lg italic font-semibold text-orange-400" data-i18n={exp.positionKey}>{t[exp.positionKey]}</h4>
                    <p class="mt-2 text-white/70" data-i18n={exp.descKey}>{t[exp.descKey]}</p>
                    {exp.tecnologies && (
                        <div class="flex flex-wrap gap-2 mt-3">
                            {exp.tecnologies.map((tech) => (
                                <span class="tech-chip bg-black border border-orange-400 text-orange-300 px-2 py-1">
                                    {tech}
                                </span>
                            ))}
                        </div>
                    )}
                </div>
            </div>
        ))
    }
</div>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
import { applyTranslations, onLangChange } from '../i18n/client';
gsap.registerPlugin(ScrollTrigger);

applyTranslations();
onLangChange(() => applyTranslations());

const cards = gsap.utils.toArray('.exp-card');
const scroller = document.getElementById('app-scroll');

if (cards.length) {
    gsap.set(cards, { opacity: 0, x: -30 });
    gsap.to(cards, {
        opacity: 1,
        x: 0,
        duration: 0.6,
        stagger: 0.15,
        ease: 'power2.out',
        scrollTrigger: {
            trigger: '#experiencia',
            scroller: scroller ?? window,
            start: 'top 85%',
        },
    });
}
</script>
