---
// const { title } = Astro.props;
import EfecctedStar from "../components/EfecctedStar.astro"
import "../style/global.css"
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>Tomy Bautista </title>
		<meta name="description" content="It's Tomy Bautista's  personal resume website." />
		<meta name="author" content="Tomy Bautista" />
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
	</head>
	<style>
		body {
  		font-family: 'VT323', monospace;
  		background: #000;
		}
	</style>
	<body>
		<EfecctedStar client:load />
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
